# Copy to .env (gitignored) or to the service env file on the server. Never commit real values.
HOST=127.0.0.1
PORT=3460
# Path prefix when served behind the private HTTPS proxy, for example /job-search. Empty for local dev.
BASE_PATH=
DATA_DIR=data
EXPORT_DIR=exports
PROFILE_PATH=config/profile.json
LOG_LEVEL=info

# Gog (Gmail read access). The keyring password is a secret: set it only in the env file.
GOG_BIN=gog
GOG_ACCOUNT=<your-gmail-account>
GOG_KEYRING_PASSWORD=

# Codex (scoring). Uses the ChatGPT sign-in already stored for the codex CLI.
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_MS=180000
# Set to 1 to skip AI extraction and score from the deterministic rules only.
SCORE_RULES_ONLY=0
